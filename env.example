# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- PostgreSQL Database ---
# Thong tin ket noi Postgres dung luc chay ung dung (server.ts, src/db/index.ts)
SQL_HOST="localhost"
SQL_USER="app_user"
SQL_PASSWORD="MY_DB_PASSWORD"
SQL_DB_NAME="qltt"

# Tai khoan RIENG dung cho drizzle-kit khi generate/migrate schema (src/db/drizzle.config.ts).
# Nen la 1 user Postgres co quyen cao hon app_user o tren (tach quyen, khong dung chung).
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="MY_DB_ADMIN_PASSWORD"

# --- Tich hop camera Hanet AI (webhook) ---
# Lay tu App da tao tren developers.hanet.ai. Dung de tu tinh lai hash = MD5(client_secret + id)
# va so khop voi hash Hanet gui kem moi request, xac minh request that su den tu Hanet.
HANET_CLIENT_SECRET="MY_HANET_CLIENT_SECRET"

# Dung tam thoi khi webhook nhan duoc check-in tu 1 FaceID CHUA duoc lien ket voi hoc vien nao
# trong he thong (chua biet chac tenant nao). He thong hien tai moi co 1 trung tam su dung,
# nen dung 1 gia tri co dinh. Neu sau nay co nhieu trung tam dung chung server voi cac App
# Hanet rieng, can thay bang co che anh xa theo keycode thay vi 1 bien co dinh.
HANET_DEFAULT_TENANT_ID="MY_TENANT_ID"
